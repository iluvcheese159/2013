@import url('https://fonts.googleapis.com/css2?family=Chivo:wght@300;400;500;700;900&family=Work+Sans:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
    :root {
        --background: 0 0% 100%;
        --foreground: 0 0% 7%;
        --card: 0 0% 100%;
        --card-foreground: 0 0% 7%;
        --popover: 0 0% 100%;
        --popover-foreground: 0 0% 7%;
        --primary: 270 91% 65%;
        --primary-foreground: 0 0% 100%;
        --secondary: 0 0% 96%;
        --secondary-foreground: 0 0% 7%;
        --muted: 0 0% 96%;
        --muted-foreground: 0 0% 40%;
        --accent: 265 84% 78%;
        --accent-foreground: 0 0% 7%;
        --destructive: 0 84% 60%;
        --destructive-foreground: 0 0% 98%;
        --border: 0 0% 90%;
        --input: 0 0% 90%;
        --ring: 270 91% 65%;
        --radius: 0.25rem;
        --surface: 0 0% 100%;
    }
    .dark {
        --background: 0 0% 3%;
        --foreground: 0 0% 96%;
        --card: 0 0% 6%;
        --card-foreground: 0 0% 96%;
        --popover: 0 0% 6%;
        --popover-foreground: 0 0% 96%;
        --primary: 270 91% 70%;
        --primary-foreground: 0 0% 100%;
        --secondary: 0 0% 10%;
        --secondary-foreground: 0 0% 96%;
        --muted: 0 0% 10%;
        --muted-foreground: 0 0% 55%;
        --accent: 265 84% 78%;
        --accent-foreground: 0 0% 3%;
        --destructive: 0 62% 50%;
        --destructive-foreground: 0 0% 96%;
        --border: 0 0% 13%;
        --input: 0 0% 13%;
        --ring: 270 91% 70%;
        --surface: 0 0% 6%;
    }
}

@layer base {
    * {
        @apply border-border;
    }
    html, body {
        @apply bg-background text-foreground;
        font-family: 'Work Sans', system-ui, sans-serif;
        font-weight: 400;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
    }
    h1, h2, h3, h4, h5, h6 {
        font-family: 'Chivo', sans-serif;
        letter-spacing: -0.025em;
        font-weight: 500;
    }
    .font-mono, code, pre, kbd {
        font-family: 'Space Mono', ui-monospace, monospace;
    }
}

@layer utilities {
    .font-display { font-family: 'Chivo', sans-serif; }
    .font-body { font-family: 'Work Sans', sans-serif; }
    .font-tech { font-family: 'Space Mono', monospace; }

    .ticker-line {
        background-image: linear-gradient(90deg, hsl(var(--border)) 50%, transparent 50%);
        background-size: 10px 1px;
        background-repeat: repeat-x;
        background-position: 0 50%;
        height: 1px;
    }
}

::selection {
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
}

@keyframes rise-in {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}
.rise-in { animation: rise-in 0.7s cubic-bezier(0.16, 1, 0.3, 1) both; }
.rise-in-1 { animation-delay: 0.08s; }
.rise-in-2 { animation-delay: 0.16s; }
.rise-in-3 { animation-delay: 0.24s; }
.rise-in-4 { animation-delay: 0.32s; }

@keyframes twinkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: 0.2; }
    50% { transform: scale(1.2); opacity: 0.4; }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(10px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}
