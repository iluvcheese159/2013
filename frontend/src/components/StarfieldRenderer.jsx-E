/* eslint-disable */
import { useMemo } from "react";

const BACKGROUND_STAR_COUNT = 400;

// Power function for exponential distribution - favors small values
function powerDistribution(min, max, exponent, random) {
  return min + (max - min) * Math.pow(random, exponent);
}

// Gaussian-like distribution for clustered placement
function gaussianRandom(mean, stdev, random) {
  const u = 1 - random(); 
  const v = random();
  const z = Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
  return z * stdev + mean;
}

// Generate realistic star colors (subtle tints)
function getStarColor(random) {
  const r = random();
  if (r < 0.6) {
    // Pale blue-white (most common)
    return { r: 240, g: 245, b: 255, tint: "blue-white" };
  } else if (r < 0.85) {
    // Warm white
    return { r: 255, g: 250, b: 240, tint: "warm-white" };
  } else {
    // Faint orange (rare)
    return { r: 255, g: 240, b: 220, tint: "orange" };
  }
}

function generateRealisticStars(count, seed) {
  const stars = [];
  // Seeded random for consistency
  let seedValue = seed;
  const random = () => {
    seedValue = (seedValue * 9301 + 49297) % 233280;
    return seedValue / 233280;
  };

  // Create Milky Way-like diagonal band with higher density
  const milkyWayAngle = Math.PI / 4; // 45 degrees
  const milkyWayWidth = 0.3; // Width of the dense band

  for (let i = 0; i < count; i++) {
    const r = random();
    
    // Position with clustering - some areas denser
    let x, y;
    const inMilkyWay = random() < 0.4; // 40% of stars in the band
    
    if (inMilkyWay) {
      // Position along the diagonal band
      const bandPos = random();
      const bandOffset = gaussianRandom(0, milkyWayWidth / 2, random());
      
      x = bandPos + bandOffset * Math.cos(milkyWayAngle + Math.PI / 2);
      y = bandPos + bandOffset * Math.sin(milkyWayAngle + Math.PI / 2);
      
      // Clamp to 0-1
      x = Math.max(0, Math.min(1, x));
      y = Math.max(0, Math.min(1, y));
    } else {
      // Random position outside the band
      x = random();
      y = random();
    }

    // Size: exponential distribution - most stars tiny, few large
    // Using powerDistribution with exponent > 1 to favor small values
    const size = powerDistribution(0.5, 3.5, 3, random());
    
    // Brightness: correlated with size but with variation
    const baseBrightness = size / 3.5;
    const brightness = baseBrightness * (0.5 + random() * 0.5);
    
    // Color tint
    const color = getStarColor(random);
    
    // Twinkle: slow, staggered
    const twinkleSpeed = 2 + random() * 4; // 2-6 seconds
    const twinklePhase = random() * Math.PI * 2; // Random starting phase

    stars.push({
      id: i,
      x: x * 100,
      y: y * 100,
      size,
      opacity: 0.2 + brightness * 0.6, // Range 0.2-0.8
      color: `rgb(${color.r}, ${color.g}, ${color.b})`,
      twinkleSpeed,
      twinklePhase,
    });
  }

  return stars;
}

export default function StarfieldRenderer({ 
  starCount = BACKGROUND_STAR_COUNT, 
  seed = Date.now(),
  className = "",
  offset = null,
}) {
  const stars = useMemo(() => generateRealisticStars(starCount, seed), [starCount, seed]);

  // When offset is provided the star layer is 3× the viewport so panning
  // reveals stars beyond the initial view. Stars are placed across 0–300%
  // of the container; the container itself is clipped by the parent.
  const pannable = offset !== null;

  return (
    <div className={`absolute inset-0 overflow-hidden ${className}`}>
      <div
        style={pannable ? {
          position: "absolute",
          width: "300%",
          height: "300%",
          top: "-100%",
          left: "-100%",
          transform: `translate(${offset.x}px, ${offset.y}px)`,
          willChange: "transform",
        } : { position: "absolute", inset: 0 }}
      >
        {stars.map((star) => (
          <div
            key={star.id}
            className="absolute rounded-full"
            style={{
              left: `${star.x}%`,
              top: `${star.y}%`,
              width: `${star.size}px`,
              height: `${star.size}px`,
              backgroundColor: star.color,
              opacity: star.opacity,
              animation: `twinkle ${star.twinkleSpeed}s ease-in-out infinite`,
              animationDelay: `${star.twinklePhase}s`,
            }}
          />
        ))}
      </div>
    </div>
  );
}
