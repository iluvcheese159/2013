/* eslint-disable */
import { useState, useEffect } from "react";
import Bob, { BobSleeping } from "./Bob";

// Random funny lines for when Bob is disturbed
const SLEEPY_LINES = [
  "What?",
  "I'm trying to sleep here!",
  "Five more minutes...",
  "Do you know what time it is?",
  "Zzz... what?",
  "Can't a bot get some rest?",
];

export default function TentScene({ bobInside = true, onTentClick }) {
  const [fireflies, setFireflies] = useState([]);
  const [windPhase, setWindPhase] = useState(0);
  const [bobSleepingVisible, setBobSleepingVisible] = useState(false);
  const [sleepyLine, setSleepyLine] = useState("");

  // Generate fireflies
  useEffect(() => {
    const newFireflies = [];
    for (let i = 0; i < 8; i++) {
      newFireflies.push({
        id: i,
        x: Math.random() * 100,
        y: Math.random() * 60 + 20,
        phase: Math.random() * Math.PI * 2,
        speed: 0.5 + Math.random() * 0.5,
      });
    }
    setFireflies(newFireflies);
  }, []);

  // Wind animation
  useEffect(() => {
    const interval = setInterval(() => {
      setWindPhase((prev) => prev + 0.05);
    }, 50);
    return () => clearInterval(interval);
  }, []);

  const windOffset = Math.sin(windPhase) * 3;

  const handleTentClick = () => {
    if (bobInside) {
      setBobSleepingVisible(true);
      setSleepyLine(SLEEPY_LINES[Math.floor(Math.random() * SLEEPY_LINES.length)]);
      setTimeout(() => setBobSleepingVisible(false), 2000);
    }
    onTentClick?.();
  };

  return (
    <div 
      className="absolute bottom-4 left-4 w-48 h-40 cursor-pointer"
      onClick={handleTentClick}
    >
      <svg width="192" height="160" viewBox="0 0 192 160">
        {/* Ground patch */}
        <ellipse 
          cx="96" cy="140" 
          rx="80" ry="20" 
          fill="#1f2937" 
        />
        <ellipse 
          cx="96" cy="138" 
          rx="70" ry="15" 
          fill="#374151" 
        />
        
        {/* Trees behind tent */}
        <g transform={`translate(${windOffset * 0.3}, 0)`}>
          {/* Tree 1 */}
          <rect x="20" y="80" width="8" height="40" fill="#78350f" />
          <polygon points="24,40 4,80 44,80" fill="#166534" />
          <polygon points="24,50 8,75 40,75" fill="#15803d" />
          
          {/* Tree 2 */}
          <rect x="160" y="85" width="6" height="35" fill="#78350f" />
          <polygon points="163,50 148,80 178,80" fill="#166534" />
          <polygon points="163,60 150,78 176,78" fill="#15803d" />
        </g>
        
        {/* Tent */}
        <g transform={`translate(${windOffset}, 0)`}>
          {/* Tent body */}
          <path 
            d="M50 140 L96 60 L142 140 Z" 
            fill="#4b5563" 
            stroke="#6b7280" 
            strokeWidth="2"
          />
          
          {/* Tent opening */}
          <path 
            d="M85 140 L96 90 L107 140 Z" 
            fill="#1f2937" 
          />
          
          {/* Tent fabric lines */}
          <line x1="70" y1="100" x2="96" y2="60" stroke="#6b7280" strokeWidth="1" />
          <line x1="122" y1="100" x2="96" y2="60" stroke="#6b7280" strokeWidth="1" />
          
          {/* Warm glow when Bob is inside */}
          {bobInside && (
            <ellipse 
              cx="96" cy="115" 
              rx="15" ry="20" 
              fill="#fbbf24" 
              opacity="0.3"
              style={{ animation: 'glow 2s ease-in-out infinite' }}
            />
          )}
        </g>
        
        {/* Fireflies */}
        {fireflies.map((fly) => {
          const y = fly.y + Math.sin(windPhase * fly.speed + fly.phase) * 5;
          const opacity = 0.5 + Math.sin(windPhase * 2 + fly.phase) * 0.5;
          return (
            <circle
              key={fly.id}
              cx={fly.x * 1.5}
              cy={y}
              r="2"
              fill="#fef08a"
              opacity={opacity}
              style={{ animation: 'twinkle 1s ease-in-out infinite' }}
            />
          );
        })}
        
        {/* Grass swaying */}
        <g transform={`translate(${windOffset * 0.5}, 0)`}>
          {[...Array(12)].map((_, i) => {
            const x = 30 + i * 12;
            const height = 8 + Math.random() * 6;
            return (
              <path
                key={i}
                d={`M${x} 140 Q${x + Math.sin(windPhase + i) * 3} ${140 - height} ${x} ${140 - height}`}
                stroke="#22c55e"
                strokeWidth="2"
                fill="none"
              />
            );
          })}
        </g>
      </svg>
      
      {/* Bob sleeping - pokes head out when tent clicked */}
      {bobSleepingVisible && (
        <div 
          className="absolute bottom-16 left-16"
          style={{
            animation: 'fadeInUp 0.3s ease-out',
          }}
        >
          <BobSleeping visible />
          <div 
            className="absolute -top-10 left-1/2 -translate-x-1/2 bg-white text-black text-xs px-3 py-2 rounded-lg whitespace-nowrap font-tech"
            style={{
              animation: 'fadeIn 0.3s ease-out',
            }}
          >
            {sleepyLine}
          </div>
        </div>
      )}
    </div>
  );
}
